{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows-SQL Monitor",
  "version": "1.2.2",
  "identifier": "com.windowssql.monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Windows-SQL Monitor — Monitor de Windows Server y SQL Server",
        "width": 1220,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "William Jiménez Puentes",
    "copyright": "© 2026 William Jiménez Puentes",
    "homepage": "https://github.com/willljp93",
    "shortDescription": "Monitor de Windows Server y SQL Server en bandeja del sistema",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
